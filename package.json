{
    "name": "network-canvas-architect",
    "version": "7.0.0-alpha.4",
    "productName": "Network Canvas Architect",
    "description": "A tool for building Network Canvas interviews.",
    "author": "Complex Data Collective <info@networkcanvas.com>",
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@9.15.4",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "pack": "electron-builder --dir",
        "lint": "pnpm run lint:js && pnpm run sass-lint",
        "lint:js": "eslint src",
        "sass-lint": "stylelint **/*.scss",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:update-snapshots": "vitest run --update",
        "generate-icons": "node scripts/generate-app-icons.js",
        "dist": "electron-builder",
        "dist:mac": "pnpm run build && electron-builder -m --x64 --arm64",
        "dist:linux": "pnpm run build && electron-builder -l",
        "dist:win": "pnpm run build && electron-builder -w",
        "dist:all": "pnpm run build && electron-builder -mlw",
        "bump": "node scripts/bump.js",
        "preflight": "pnpm run lint:js && pnpm run sass-lint -- --max-warnings 0 && pnpm test"
    },
    "repository": {
        "type": "git"
    },
    "devDependencies": {
        "@babel/cli": "^7.12.1",
        "@babel/core": "^7.12.3",
        "@babel/eslint-parser": "^7.13.10",
        "@babel/eslint-plugin": "^7.13.10",
        "@babel/plugin-proposal-class-properties": "^7.12.1",
        "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
        "@babel/plugin-transform-private-methods": "^7.27.1",
        "@babel/plugin-transform-private-property-in-object": "^7.27.1",
        "@babel/preset-env": "^7.27.2",
        "@babel/preset-react": "^7.12.1",
        "@codaco/protocol-validation": "^5.0.2",
        "@codaco/ui": "^5.8.5",
        "@electron/notarize": "^2.3.0",
        "@material-ui/icons": "^4.11.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^12.0.0",
        "@tippyjs/react": "^4.2.5",
        "@vitejs/plugin-react": "^5.1.2",
        "@vitest/coverage-v8": "^4.0.16",
        "animejs": "^2.2.0",
        "archiver": "^3.1.1",
        "autoprefixer": "^9.8.8",
        "axios": "^0.27.2",
        "babel-runtime": "6.26.0",
        "change-case": "^3.0.1",
        "classnames": "^2.2.6",
        "compare-versions": "^3.6.0",
        "csv-parse": "^4.10.1",
        "csvtojson": "^2.0.10",
        "decompress": "^4.2.1",
        "dmg-builder": "^25.1.8",
        "electron": "^34.0.0",
        "electron-builder": "^25.1.8",
        "electron-devtools-installer": "^3.2.0",
        "electron-log": "^4.2.2",
        "electron-vite": "^5.0.0",
        "emoji-dictionary": "^1.0.9",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.4",
        "enzyme-to-json": "^3.6.1",
        "eslint": "^7.0.0",
        "eslint-config-airbnb": "^18.2.1",
        "eslint-config-react-app": "^6.0.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "2.22.1",
        "eslint-plugin-jsx-a11y": "6.4.1",
        "eslint-plugin-react": "^7.11.1",
        "faker": "^4.1.0",
        "framer-motion": "^5.5.6",
        "fs-extra": "^8.1.0",
        "fuse.js": "^3.6.1",
        "history": "^4.7.2",
        "icon-gen": "^1.0.5",
        "jsdom": "^27.4.0",
        "jszip": "^3.10.1",
        "lodash": "^4.17.19",
        "luxon": "^1.24.1",
        "mapbox-gl": "^3.9.3",
        "object-hash": "^1.3.0",
        "path-to-regexp": "^2.4.0",
        "postcss": "^8.4.28",
        "postcss-loader": "^4.3.0",
        "postcss-preset-env": "^9.1.2",
        "postcss-url": "^8.0.0",
        "prop-types": "^15.6.2",
        "react": "^16.13.1",
        "react-dom": "^16.13.1",
        "react-flip-toolkit": "^6.5.4",
        "react-grid-layout": "^0.16.6",
        "react-redux": "^7.2.1",
        "react-router-dom": "~5.2.0",
        "react-router-hash-link": "^2.4.1",
        "react-select": "^3.1.0",
        "react-sortable-hoc": "^2.0.0",
        "react-table": "^7.7.0",
        "react-test-renderer": "^16.13.1",
        "react-transition-group": "^4.4.1",
        "react-virtualized-auto-sizer": "^1.0.6",
        "react-window": "^1.8.6",
        "recompose": "^0.30.0",
        "redux": "^4.0.5",
        "redux-form": "^8.3.6",
        "redux-logger": "^2.7.4",
        "redux-mock-store": "^1.5.4",
        "redux-persist": "^6.0.0",
        "redux-thunk": "^2.3.0",
        "reselect": "^3.0.0",
        "rxjs": "^6.6.6",
        "sass": "^1.97.2",
        "scrollparent": "^2.0.1",
        "stylelint": "^15.10.3",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-config-standard-scss": "^10.0.0",
        "svg2png": "^3.0.1",
        "uuid": "^3.4.0",
        "vite": "^7.3.1",
        "vitest": "^4.0.16"
    },
    "homepage": ".",
    "main": "dist/main/index.js",
    "build": {
        "extends": null,
        "appId": "NetworkCanvasArchitect",
        "afterSign": "./build-resources/scripts/afterSignHook.js",
        "files": [
            "dist/**/*",
            "public/icons/**/*"
        ],
        "directories": {
            "buildResources": "build-resources",
            "output": "release-builds"
        },
        "mac": {
            "category": "public.app-category.education",
            "hardenedRuntime": true,
            "entitlements": "./build-resources/entitlements.mac.inherit.plist"
        },
        "win": {
            "target": "nsis",
            "certificateSha1": "8F1243989C0B23B29B50E872282AAB00A4302CCD"
        },
        "linux": {
            "maintainer": "Joshua Melville <joshmelville@gmail.com>",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "fileAssociations": {
            "ext": "netcanvas",
            "description": "Network Canvas interview protocol",
            "icon": "file",
            "role": "Editor"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "complexdatacollective",
                "repo": "architect"
            }
        ]
    }
}
